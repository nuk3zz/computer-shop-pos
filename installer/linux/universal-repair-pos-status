#!/bin/sh
set -eu

systemctl --no-pager --full status universal-repair-pos.service || true
echo ""
echo "Local URL: http://localhost:3000"
for address in $(hostname -I 2>/dev/null); do
  case "$address" in
    *:*) ;;
    *) echo "LAN URL:   http://$address:3000" ;;
  esac
done
if [ -r /etc/universal-repair-pos/data-dir ]; then
  echo "Data:      $(head -n 1 /etc/universal-repair-pos/data-dir)"
fi
