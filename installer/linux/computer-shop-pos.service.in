[Unit]
Description=Computer Shop POS server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory="@DATA_DIR@"
ExecStart=/usr/bin/computer-shop-pos --native "--data-dir=@DATA_DIR@" --port=3000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths="@DATA_DIR@"

[Install]
WantedBy=multi-user.target
