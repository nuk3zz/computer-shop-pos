#!/bin/sh
set -eu

console_user="$(stat -f '%Su' /dev/console)"
if [ -z "$console_user" ] || [ "$console_user" = "root" ]; then
  exit 0
fi

user_id="$(id -u "$console_user")"
agent_path="/Library/LaunchAgents/io.github.computer-shop-pos.plist"
launchctl bootout "gui/$user_id/io.github.computer-shop-pos" >/dev/null 2>&1 || true
launchctl bootstrap "gui/$user_id" "$agent_path" >/dev/null 2>&1 || true
launchctl enable "gui/$user_id/io.github.computer-shop-pos" >/dev/null 2>&1 || true
launchctl kickstart -k "gui/$user_id/io.github.computer-shop-pos" >/dev/null 2>&1 || true
launchctl asuser "$user_id" open "http://localhost:3000/setup" >/dev/null 2>&1 || true
exit 0
