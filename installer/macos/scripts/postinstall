#!/bin/sh
set -eu

console_user="$(stat -f '%Su' /dev/console)"
if [ -z "$console_user" ] || [ "$console_user" = "root" ]; then
  exit 0
fi

user_id="$(id -u "$console_user")"
user_home="$(dscl . -read "/Users/$console_user" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"

# Stop and remove the previous branded launcher while retaining and migrating data.
launchctl bootout "gui/$user_id/io.github.computer-shop-pos" >/dev/null 2>&1 || true
rm -f /Library/LaunchAgents/io.github.computer-shop-pos.plist /usr/local/bin/computer-shop-pos
if [ -n "$user_home" ] && [ -d "$user_home/Documents/Computer Shop POS" ] && [ ! -e "$user_home/Documents/Universal Repair POS" ]; then
  mv "$user_home/Documents/Computer Shop POS" "$user_home/Documents/Universal Repair POS"
fi

agent_path="/Library/LaunchAgents/io.github.universal-repair-pos.plist"
launchctl bootout "gui/$user_id/io.github.universal-repair-pos" >/dev/null 2>&1 || true
install_log=/tmp/universal-repair-pos-install.log
loaded=false
attempt=1
while [ "$attempt" -le 5 ]; do
  if launchctl bootstrap "gui/$user_id" "$agent_path" >>"$install_log" 2>&1; then
    loaded=true
    break
  fi
  launchctl bootout "gui/$user_id/io.github.universal-repair-pos" >>"$install_log" 2>&1 || true
  sleep 1
  attempt=$((attempt + 1))
done
if [ "$loaded" = true ]; then
  launchctl enable "gui/$user_id/io.github.universal-repair-pos" >>"$install_log" 2>&1 || true
  launchctl kickstart -k "gui/$user_id/io.github.universal-repair-pos" >>"$install_log" 2>&1 || true
fi

attempt=1
while [ "$attempt" -le 20 ]; do
  if /usr/bin/curl -fsS --max-time 1 "http://127.0.0.1:3210/health" >/dev/null 2>&1; then
    break
  fi
  sleep 1
  attempt=$((attempt + 1))
done
launchctl asuser "$user_id" open "http://localhost:3210/setup" >>"$install_log" 2>&1 || true
exit 0
